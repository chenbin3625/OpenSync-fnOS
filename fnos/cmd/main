#!/bin/bash
set -eu
umask 077

fail() {
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then { printf '%s\n' "$1" > "$TRIM_TEMP_LOGFILE"; } 2>/dev/null || true; fi
    printf '%s\n' "$1" >&2
    exit 1
}
for name in TRIM_APPDEST TRIM_PKGVAR TRIM_PKGETC TRIM_PKGTMP; do
    value="${!name:-}"
    [ -n "$value" ] && [ "${value:0:1}" = / ] && [ "$value" != / ] || fail "缺少有效的应用目录变量：$name"
done
BIN="${TRIM_APPDEST}/server/opensync"
BIN_REAL="$(readlink -f "$BIN" 2>/dev/null || true)"
if [ -z "$BIN_REAL" ]; then
    BIN_DIR_REAL="$(cd "$(dirname "$BIN")" 2>/dev/null && pwd -P || true)"
    if [ -n "$BIN_DIR_REAL" ]; then
        BIN_REAL="${BIN_DIR_REAL}/$(basename "$BIN")"
    else
        BIN_REAL="$BIN"
    fi
fi
PID_FILE="${TRIM_PKGVAR}/app.pid"
SOCKET="${TRIM_APPDEST}/app.sock"
LOG_FILE="${TRIM_PKGVAR}/app.log"
# 服务进程会持续运行数周，gin 每个请求写一行日志；启动时按大小轮转，
# 保留 app.log.1 .. app.log.5，避免日志无限增长占满数据盘。
LOG_MAX_BYTES=10485760
LOG_KEEP=5
# 长跑期间由后台看护进程按同样阈值轮转；测试可用环境变量缩短检查间隔。
LOG_CHECK_INTERVAL="${OPENSYNC_LOG_CHECK_INTERVAL:-300}"
LOG_ROTATOR_PID_FILE="${TRIM_PKGVAR}/log-rotator.pid"
# 等待服务创建 Socket 的最长秒数；期间持续确认进程仍存活。
START_TIMEOUT=60
# 本脚本的规范路径，用于确认启动锁的持有者仍是本应用的 `main start|stop`。
SELF="$(readlink -f "$0" 2>/dev/null || true)"
# start / stop 共用的生命周期锁。有 flock 时用它做内核级互斥（进程退出即释放，
# 不存在“建锁到写 PID 之间”的空窗）；start.lock 目录 + pid 仍在 flock 保护下维护，
# 兼容旧版脚本并作为缺少 flock 时的回退。
LIFECYCLE_LOCK="${TRIM_PKGTMP}/lifecycle.lock"
START_LOCK="${TRIM_PKGTMP}/start.lock"
# stop 需要等待正在进行的 start（最长 START_TIMEOUT 秒）结束。
STOP_LOCK_WAIT=$((START_TIMEOUT + 30))
# upgrade_init 写入：下一次 start 失败时提示升级前备份的位置，成功后删除。
UPGRADE_PENDING="${TRIM_PKGVAR}/upgrade-pending"
LAST_BACKUP_FILE="${TRIM_PKGVAR}/last-upgrade-backup"
LOCK_OWNED=0
FLOCK_HELD=0

check_process() {
    local pid="$1" executable
    case "$pid" in ''|*[!0-9]*|0|1) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    if [ -d /proc ]; then
        executable="$(readlink "/proc/$pid/exe" 2>/dev/null)" || return 1
        [ "$executable" = "$BIN" ] || [ "$executable" = "$BIN (deleted)" ] || \
            [ "$executable" = "$BIN_REAL" ] || [ "$executable" = "$BIN_REAL (deleted)" ]
    else
        executable="$(ps -p "$pid" -o command= 2>/dev/null)" || return 1
        [ "$executable" = "$BIN" ]
    fi
}
# pid 文件丢失、被截断或指向无关进程时，按可执行文件身份扫描 /proc 找回服务进程，
# 避免 stop 在服务仍运行时报告成功（升级随后会拷贝正在写入的数据库）。
find_service_pid() {
    local entry pid
    [ -d /proc ] || return 1
    for entry in /proc/[0-9]*; do
        pid="${entry#/proc/}"
        [ "$pid" != "$$" ] || continue
        if check_process "$pid"; then printf '%s\n' "$pid"; return 0; fi
    done
    return 1
}
status_app() {
    PID=''
    if [ -f "$PID_FILE" ]; then
        PID="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
        if check_process "$PID"; then return 0; fi
    fi
    PID="$(find_service_pid)" || { PID=''; return 1; }
    # 找回的进程重新记入 pid 文件，后续 status / stop 不必再扫描。
    { printf '%s\n' "$PID" > "$PID_FILE"; } 2>/dev/null || true
}
socket_in_use() {
    [ -S "$SOCKET" ] && [ ! -L "$SOCKET" ] || return 1
    if command -v flock >/dev/null 2>&1 && [ -f "${TRIM_APPDEST}/.app.lock" ]; then
        local lock_rc=0
        flock -E 11 -n "${TRIM_APPDEST}/.app.lock" true 2>/dev/null || lock_rc=$?
        [ "$lock_rc" -eq 11 ] && return 0
    fi
    if command -v python3 >/dev/null 2>&1; then
        python3 -c '
import errno, socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(1)
try:
    s.connect(sys.argv[1])
except OSError as e:
    if e.errno in (errno.ECONNREFUSED, errno.ENOENT):
        sys.exit(1)
    sys.exit(0)
finally:
    s.close()
' "$SOCKET" 2>/dev/null
        return $?
    fi
    if command -v curl >/dev/null 2>&1; then
        local curl_rc=0
        curl --unix-socket "$SOCKET" --connect-timeout 1 --max-time 1 -s -o /dev/null http://localhost/app/opensync/svr/session 2>/dev/null || curl_rc=$?
        [ "$curl_rc" -ne 7 ] && return 0
        return 1
    fi
    if command -v socat >/dev/null 2>&1; then
        socat -T 1 -u OPEN:/dev/null "UNIX-CONNECT:$SOCKET" >/dev/null 2>&1 && return 0
        return 1
    fi
    if command -v fuser >/dev/null 2>&1; then
        [ -n "$(fuser "$SOCKET" 2>/dev/null | tr -d '[:space:]')" ] && return 0
    fi
    if command -v ss >/dev/null 2>&1; then
        ss -lx 2>/dev/null | grep -F -- "$SOCKET" >/dev/null && return 0
    fi
    return 1
}
stop_app() {
    mkdir -p "$TRIM_PKGTMP"
    acquire_lifecycle_lock "$STOP_LOCK_WAIT" '应用正在启动或停止，请稍后重试'
    stop_log_rotator
    if ! status_app; then rm -f "$PID_FILE"; return 0; fi
    if ! kill -TERM "$PID" 2>/dev/null; then
        # status 与 kill 之间进程可能已自行退出，这属于停止成功。
        if check_process "$PID"; then fail '无法停止应用，请检查运行权限'; fi
    fi
    local count=0
    while check_process "$PID" && [ "$count" -lt 40 ]; do sleep 1; count=$((count + 1)); done
    if check_process "$PID"; then fail '应用尚未完成停止，请稍后重试；未强制结束以保护任务数据'; fi
    rm -f "$PID_FILE"
    [ ! -S "$SOCKET" ] || rm -f "$SOCKET"
}
# $1 是锁持有进程 argv 中紧挨 start 之前的参数：必须是名为 main 的脚本；是绝对路径
# 时还必须解析到本脚本。相对路径依赖对方的工作目录（start_app 会 cd），无法可靠还原，
# 此时与缺少 readlink -f 时一样只按文件名判断，宁可让用户稍后重试也不重复启动。
is_self_path() {
    local path="$1" real
    case "$path" in main|*/main) ;; *) return 1 ;; esac
    case "$path" in /*) ;; *) return 0 ;; esac
    [ -n "$SELF" ] || return 0
    real="$(readlink -f "$path" 2>/dev/null || true)"
    [ "$real" = "$SELF" ]
}
# 锁里的 PID 可能已被无关的长驻进程复用：只有它仍在执行本脚本的 start 或 stop 才
# 视为锁仍被持有，否则按残留锁处理，避免启动被永久阻塞。
is_lifecycle_script() {
    local pid="$1" arg prev='' cmdline
    kill -0 "$pid" 2>/dev/null || return 1
    if [ -d /proc ]; then
        # 读不到命令行时无法确认身份，保守地沿用 kill -0 的结论。
        [ -r "/proc/$pid/cmdline" ] || return 0
        while IFS= read -r arg || [ -n "$arg" ]; do
            case "$arg" in start|stop) if is_self_path "$prev"; then return 0; fi ;; esac
            prev="$arg"
        done < <({ tr '\0' '\n' < "/proc/$pid/cmdline"; } 2>/dev/null || true)
        return 1
    fi
    cmdline="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    if [ -n "$cmdline" ]; then
        case " $cmdline " in *[/\ ]main\ start\ *|*[/\ ]main\ stop\ *) return 0 ;; *) return 1 ;; esac
    fi
    # 没有 /proc 且 ps 给不出命令行时无法确认身份，保守地沿用 kill -0 的结论。
    kill -0 "$pid" 2>/dev/null
}
read_lock_pid() {
    local value=''
    if [ -f "$START_LOCK/pid" ]; then
        value="$(head -n 1 "$START_LOCK/pid" 2>/dev/null | tr -d '[:space:]')" || value=''
    fi
    printf '%s' "$value"
}
# 把判定为残留的锁目录原子地改名后再删除：并发的两个回收者只有一个能改名成功，
# 不会出现“一方刚建好的锁被另一方删掉”的情况。
discard_stale_lock() {
    local trash="${START_LOCK}.stale.$$"
    mv "$START_LOCK" "$trash" 2>/dev/null || return 0
    rm -f "$trash/pid"
    rmdir "$trash" 2>/dev/null || true
}
# 在 wait 秒内取得 start.lock 目录锁。持有 flock 时目录只是兼容旧版脚本的标记；
# 没有 flock 时它是唯一的互斥手段：没有 pid 的锁目录可能是对方刚 mkdir、尚未写入
# pid，先观察几秒再按残留回收，而不是像旧版那样立即删除。
take_dir_lock() {
    local wait="$1" message="$2" deadline lock_pid empty_seen=0 attempts=0
    deadline=$(( $(date +%s) + wait ))
    while :; do
        attempts=$((attempts + 1))
        if mkdir "$START_LOCK" 2>/dev/null; then
            printf '%s\n' "$$" > "$START_LOCK/pid"
            return 0
        fi
        [ "$attempts" -le 200 ] || fail "$message"
        lock_pid="$(read_lock_pid)"
        case "$lock_pid" in
            '')
                if [ "$FLOCK_HELD" = 1 ] || [ "$empty_seen" -ge 3 ]; then
                    discard_stale_lock; continue
                fi
                empty_seen=$((empty_seen + 1)) ;;
            *[!0-9]*|0|1) discard_stale_lock; continue ;;
            *)
                empty_seen=0
                if ! is_lifecycle_script "$lock_pid"; then discard_stale_lock; continue; fi
                [ "$(date +%s)" -lt "$deadline" ] || fail "$message" ;;
        esac
        sleep 1
    done
}
# start / stop 共用的互斥。重入（start 超时后调用 stop）直接返回。
acquire_lifecycle_lock() {
    local wait="$1" message="$2"
    [ "$LOCK_OWNED" != 1 ] || return 0
    if command -v flock >/dev/null 2>&1; then
        exec 9>>"$LIFECYCLE_LOCK" || fail '无法创建应用运行锁，请检查临时目录权限'
        if [ "$wait" -gt 0 ]; then
            flock -w "$wait" 9 || fail "$message"
        else
            flock -n 9 || fail "$message"
        fi
        FLOCK_HELD=1
    fi
    take_dir_lock "$wait" "$message"
    LOCK_OWNED=1
    trap release_lifecycle_lock EXIT
}
# 只删除自己持有的锁目录；flock 随文件描述符在进程退出时自动释放。
release_lifecycle_lock() {
    [ "$LOCK_OWNED" = 1 ] || return 0
    if [ "$(read_lock_pid)" = "$$" ]; then
        rm -f "$START_LOCK/pid"
        rmdir "$START_LOCK" 2>/dev/null || true
    fi
    LOCK_OWNED=0
}
# 只在服务未运行时调用；仅对由已校验的 LOG_FILE 派生的固定后缀路径执行 mv/rm -f。
rotate_log() {
    local size index
    [ -f "$LOG_FILE" ] && [ ! -L "$LOG_FILE" ] || return 0
    size="$({ wc -c < "$LOG_FILE"; } 2>/dev/null | tr -d '[:space:]')" || return 0
    case "$size" in ''|*[!0-9]*) return 0 ;; esac
    [ "$size" -ge "$LOG_MAX_BYTES" ] || return 0
    rm -f "${LOG_FILE}.${LOG_KEEP}" || return 0
    index=$((LOG_KEEP - 1))
    while [ "$index" -ge 1 ]; do
        if [ -e "${LOG_FILE}.${index}" ]; then
            mv -f "${LOG_FILE}.${index}" "${LOG_FILE}.$((index + 1))" || return 0
        fi
        index=$((index - 1))
    done
    mv -f "$LOG_FILE" "${LOG_FILE}.1" || return 0
}
# 服务运行期间不能 mv app.log：服务持有旧 inode，重命名后日志会继续写进 .1。
# 这里用 copy-truncate：把内容复制到 .1 后清空原文件，追加写不受影响。
rotate_log_running() {
    local size index tmp_log=''
    [ -f "$LOG_FILE" ] && [ ! -L "$LOG_FILE" ] || return 0
    size="$({ wc -c < "$LOG_FILE"; } 2>/dev/null | tr -d '[:space:]')" || return 0
    case "$size" in ''|*[!0-9]*) return 0 ;; esac
    [ "$size" -ge "$LOG_MAX_BYTES" ] || return 0
    rm -f "${LOG_FILE}.${LOG_KEEP}" || return 0
    index=$((LOG_KEEP - 1))
    while [ "$index" -ge 1 ]; do
        if [ -L "${LOG_FILE}.${index}" ]; then
            rm -f "${LOG_FILE}.${index}" || return 0
        elif [ -f "${LOG_FILE}.${index}" ]; then
            mv -f "${LOG_FILE}.${index}" "${LOG_FILE}.$((index + 1))" || return 0
        fi
        index=$((index - 1))
    done
    if command -v mktemp >/dev/null 2>&1; then
        tmp_log="$(mktemp "${LOG_FILE}.1.XXXXXX" 2>/dev/null)" || return 0
    else
        tmp_log="${LOG_FILE}.1.tmp.$$"
        [ ! -e "$tmp_log" ] && [ ! -L "$tmp_log" ] || return 0
    fi
    if ! cp -P "$LOG_FILE" "$tmp_log" 2>/dev/null; then
        rm -f "$tmp_log"
        return 0
    fi
    if [ -L "${LOG_FILE}.1" ] || [ -e "${LOG_FILE}.1" ]; then
        rm -f "${LOG_FILE}.1" || { rm -f "$tmp_log"; return 0; }
    fi
    mv -f "$tmp_log" "${LOG_FILE}.1" || { rm -f "$tmp_log"; return 0; }
    [ -f "$LOG_FILE" ] && [ ! -L "$LOG_FILE" ] || return 0
    : > "$LOG_FILE"
}
# 看护进程只做日志轮转，服务退出后自动结束。9>&- 必须保留：否则它继承
# 生命周期锁的 fd，会一直持有 flock，导致之后的 stop/start 拿不到锁。
start_log_rotator() {
    local service_pid="$1"
    stop_log_rotator
    export LOG_FILE LOG_MAX_BYTES LOG_KEEP LOG_CHECK_INTERVAL
    export -f rotate_log_running
    local rotator_script='
        service_pid="$1"
        sleep_pid=""
        cleanup_rotator() {
            [ -n "$sleep_pid" ] && kill "$sleep_pid" 2>/dev/null || true
            exit 0
        }
        trap cleanup_rotator TERM INT HUP
        while kill -0 "$service_pid" 2>/dev/null; do
            sleep "$LOG_CHECK_INTERVAL" &
            sleep_pid=$!
            wait "$sleep_pid" 2>/dev/null || true
            sleep_pid=""
            kill -0 "$service_pid" 2>/dev/null || break
            rotate_log_running
        done
    '
    if command -v setsid >/dev/null 2>&1; then
        setsid bash -c "$rotator_script" opensync-log-rotator "$service_pid" "$LOG_FILE" 9>&- </dev/null >/dev/null 2>&1 &
    else
        bash -c "$rotator_script" opensync-log-rotator "$service_pid" "$LOG_FILE" 9>&- </dev/null >/dev/null 2>&1 &
    fi
    local rotator_pid=$! start_time=''
    if [ -d /proc ] && [ -r "/proc/$rotator_pid/stat" ]; then
        start_time="$(proc_start_time "$rotator_pid" 2>/dev/null || true)"
    fi
    printf '%s %s\n' "$rotator_pid" "$start_time" > "$LOG_ROTATOR_PID_FILE" 2>/dev/null || true
}
proc_stat_field() {
    local pid="$1" field="$2" stat rest
    [ -r "/proc/$pid/stat" ] || return 1
    stat="$(cat "/proc/$pid/stat" 2>/dev/null)" || return 1
    rest="${stat##*) }"
    set -- $rest
    [ "$#" -ge "$field" ] || return 1
    shift $((field - 1))
    printf '%s\n' "$1"
}
proc_state() {
    proc_stat_field "$1" 1
}
proc_ppid() {
    proc_stat_field "$1" 2
}
proc_pgid() {
    proc_stat_field "$1" 3
}
proc_start_time() {
    proc_stat_field "$1" 20
}
is_rotator_process() {
    local pid="$1" saved_start="$2" current_start='' arg has_marker=0 has_log=0 cmdline
    case "$pid" in ''|*[!0-9]*|0|1) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    if [ -d /proc ]; then
        [ "$(proc_state "$pid" 2>/dev/null || true)" != "Z" ] || return 1
        current_start="$(proc_start_time "$pid" 2>/dev/null || true)"
        if [ -n "$saved_start" ] && [ "$saved_start" != "$current_start" ]; then
            return 1
        fi
        if [ -r "/proc/$pid/cmdline" ]; then
            while IFS= read -r arg || [ -n "$arg" ]; do
                if [ "$arg" = "opensync-log-rotator" ]; then has_marker=1; fi
                if [ "$arg" = "$LOG_FILE" ]; then has_log=1; fi
            done < <({ tr '\0' '\n' < "/proc/$pid/cmdline"; } 2>/dev/null || true)
            [ "$has_marker" = 1 ] && [ "$has_log" = 1 ]
            return $?
        fi
        [ -n "$saved_start" ]
        return $?
    fi
    cmdline="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    case "$cmdline" in *opensync-log-rotator*) return 0 ;; esac
    return 1
}
list_child_pids() {
    local parent="$1" entry cpid cppid
    [ -d /proc ] || return 0
    for entry in /proc/[0-9]*; do
        cpid="${entry#/proc/}"
        [ "$cpid" != "$parent" ] || continue
        cppid="$(proc_ppid "$cpid" 2>/dev/null || true)"
        if [ "$cppid" = "$parent" ]; then
            printf '%s\n' "$cpid"
        fi
    done
}
stop_log_rotator() {
    local pid='' start_time='' pgid='' my_pgid='' children='' cpid wait_count=0
    if [ -f "$LOG_ROTATOR_PID_FILE" ]; then
        read -r pid start_time < "$LOG_ROTATOR_PID_FILE" 2>/dev/null || { pid=''; start_time=''; }
        if is_rotator_process "$pid" "$start_time"; then
            children="$(list_child_pids "$pid" || true)"
            pgid="$(proc_pgid "$pid" 2>/dev/null || true)"
            my_pgid="$(proc_pgid "$$" 2>/dev/null || true)"
            if [ -n "$pgid" ] && [ "$pgid" = "$pid" ] && [ "$pgid" != "$my_pgid" ]; then
                kill -TERM -- "-$pgid" 2>/dev/null || true
            fi
            kill -TERM "$pid" 2>/dev/null || true
            for cpid in $children; do
                kill -TERM "$cpid" 2>/dev/null || true
            done
            while [ "$wait_count" -lt 10 ] && is_rotator_process "$pid" "$start_time"; do
                sleep 0.1 2>/dev/null || sleep 1
                wait_count=$((wait_count + 1))
            done
            if is_rotator_process "$pid" "$start_time"; then
                if [ -n "$pgid" ] && [ "$pgid" = "$pid" ] && [ "$pgid" != "$my_pgid" ]; then
                    kill -KILL -- "-$pgid" 2>/dev/null || true
                fi
                kill -KILL "$pid" 2>/dev/null || true
                for cpid in $children; do
                    kill -KILL "$cpid" 2>/dev/null || true
                done
            fi
        fi
        rm -f "$LOG_ROTATOR_PID_FILE"
    fi
}
# 升级后的首次启动失败时，在错误信息里给出升级前备份的位置。不自动回滚：新版本
# 可能已迁移数据库，盲目覆盖比保留现场风险更大，恢复交给用户确认后手动进行。
fail_start() {
    local message="$1" backup=''
    if [ -f "$UPGRADE_PENDING" ] && [ -f "$LAST_BACKUP_FILE" ]; then
        IFS= read -r backup < "$LAST_BACKUP_FILE" || true
    fi
    if [ -n "$backup" ]; then
        message="${message}。升级前的数据备份位于 ${backup}，如新版本无法使用，可停止应用后将其中文件复制回 ${TRIM_PKGVAR}（config.ini 复制回 ${TRIM_PKGETC}）"
    fi
    fail "$message"
}
start_succeeded() {
    rm -f "$UPGRADE_PENDING" 2>/dev/null || true
    return 0
}
start_app() {
    mkdir -p "$TRIM_PKGVAR" "$TRIM_PKGETC" "$TRIM_PKGTMP"
    acquire_lifecycle_lock 0 '应用正在启动，请稍后重试'
    if status_app; then start_log_rotator "$PID"; start_succeeded; return 0; fi
    [ -x "$BIN" ] || fail_start '应用服务文件缺失，请重新安装对应架构的安装包'
    rotate_log
    if [ -L "$LOG_FILE" ]; then
        fail_start '日志文件是符号链接，已拒绝启动以避免写入数据目录之外'
    fi
    # 服务崩溃或被 kill -9 时 app.sock 会残留；此时已持锁且确认服务未运行，先删除，
    # 否则下面的就绪判断第一轮就会把尚未监听的服务误判为启动成功。
    if socket_in_use; then
        fail_start '应用 Socket 仍被进程占用，已拒绝启动以避免重复服务和数据库并发写入'
    fi
    if [ -e "$SOCKET" ] && [ ! -S "$SOCKET" ] && [ ! -L "$SOCKET" ]; then
        fail_start '应用 Socket 路径被普通文件占用，请移除该文件后重试'
    fi
    if [ -S "$SOCKET" ] || [ -L "$SOCKET" ]; then rm -f "$SOCKET"; fi
    cd "$TRIM_APPDEST"
    # 9>&- ：服务进程不能继承生命周期锁的描述符，否则它会一直持有 flock，
    # 之后的 stop / start 都拿不到锁。
    GIN_MODE=release "$BIN" >> "$LOG_FILE" 2>&1 9>&- &
    local pid=$!
    printf '%s\n' "$pid" > "$PID_FILE"
    # 刚 fork 出的子进程在执行 execve("$BIN") 前 /proc/$pid/exe 仍是 bash；
    # 短暂轮询等待 exec 完成，若仍未就绪则先清理残留子进程再报错，避免孤儿进程。
    local exec_wait=0
    while [ "$exec_wait" -lt 30 ]; do
        if check_process "$pid"; then
            break
        fi
        if ! kill -0 "$pid" 2>/dev/null || [ "$(proc_state "$pid" 2>/dev/null || true)" = "Z" ]; then
            break
        fi
        sleep 0.1 2>/dev/null || sleep 1
        exec_wait=$((exec_wait + 1))
    done
    if ! check_process "$pid"; then
        if kill -0 "$pid" 2>/dev/null && [ "$(proc_state "$pid" 2>/dev/null || true)" != "Z" ]; then
            kill -TERM "$pid" 2>/dev/null || true
            local term_wait=0
            while [ "$term_wait" -lt 20 ] && kill -0 "$pid" 2>/dev/null && [ "$(proc_state "$pid" 2>/dev/null || true)" != "Z" ]; do
                sleep 0.1 2>/dev/null || sleep 1
                term_wait=$((term_wait + 1))
            done
            if kill -0 "$pid" 2>/dev/null && [ "$(proc_state "$pid" 2>/dev/null || true)" != "Z" ]; then
                kill -KILL "$pid" 2>/dev/null || true
            fi
        fi
        wait "$pid" 2>/dev/null || true
        rm -f "$PID_FILE"
        fail_start '服务启动失败，请查看应用日志'
    fi
    local count=0
    while [ "$count" -lt "$START_TIMEOUT" ]; do
        if ! check_process "$pid"; then
            wait "$pid" 2>/dev/null || true
            rm -f "$PID_FILE"
            fail_start '服务启动失败，请查看应用日志'
        fi
        if [ -S "$SOCKET" ]; then
            start_log_rotator "$pid"
            start_succeeded
            return 0
        fi
        sleep 1; count=$((count + 1))
    done
    stop_app
    fail_start '服务启动超时，请查看应用日志'
}
case "${1:-}" in
    start) start_app ;;
    stop) stop_app ;;
    status) if status_app; then exit 0; else exit 3; fi ;;
    *) fail '不支持的运行操作' ;;
esac

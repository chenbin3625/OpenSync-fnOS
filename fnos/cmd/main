#!/bin/bash
set -eu
umask 077

fail() {
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then printf '%s\n' "$1" > "$TRIM_TEMP_LOGFILE"; fi
    printf '%s\n' "$1" >&2
    exit 1
}
for name in TRIM_APPDEST TRIM_PKGVAR TRIM_PKGETC TRIM_PKGTMP; do
    value="${!name:-}"
    [ -n "$value" ] && [ "${value:0:1}" = / ] && [ "$value" != / ] || fail "缺少有效的应用目录变量：$name"
done
BIN="${TRIM_APPDEST}/server/opensync"
BIN_REAL="$(readlink -f "$BIN" 2>/dev/null || true)"
if [ -z "$BIN_REAL" ]; then
    BIN_DIR_REAL="$(cd "$(dirname "$BIN")" 2>/dev/null && pwd -P || true)"
    if [ -n "$BIN_DIR_REAL" ]; then
        BIN_REAL="${BIN_DIR_REAL}/$(basename "$BIN")"
    else
        BIN_REAL="$BIN"
    fi
fi
PID_FILE="${TRIM_PKGVAR}/app.pid"
SOCKET="${TRIM_APPDEST}/app.sock"
LOG_FILE="${TRIM_PKGVAR}/app.log"

check_process() {
    local pid="$1" executable
    case "$pid" in ''|*[!0-9]*|0|1) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    if [ -d /proc ]; then
        executable="$(readlink "/proc/$pid/exe" 2>/dev/null)" || return 1
        [ "$executable" = "$BIN" ] || [ "$executable" = "$BIN (deleted)" ] || \
            [ "$executable" = "$BIN_REAL" ] || [ "$executable" = "$BIN_REAL (deleted)" ]
    else
        executable="$(ps -p "$pid" -o command= 2>/dev/null)" || return 1
        [ "$executable" = "$BIN" ]
    fi
}
status_app() {
    [ -f "$PID_FILE" ] || return 1
    PID="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    check_process "$PID"
}
stop_app() {
    if ! status_app; then rm -f "$PID_FILE"; return 0; fi
    kill -TERM "$PID" || fail '无法停止应用，请检查运行权限'
    local count=0
    while check_process "$PID" && [ "$count" -lt 40 ]; do sleep 1; count=$((count + 1)); done
    if check_process "$PID"; then fail '应用尚未完成停止，请稍后重试；未强制结束以保护任务数据'; fi
    rm -f "$PID_FILE"
    [ ! -S "$SOCKET" ] || rm -f "$SOCKET"
}
acquire_start_lock() {
    START_LOCK="${TRIM_PKGTMP}/start.lock"
    if mkdir "$START_LOCK" 2>/dev/null; then
        printf '%s\n' "$$" > "$START_LOCK/pid"
        trap 'rm -f "$START_LOCK/pid"; rmdir "$START_LOCK" 2>/dev/null || true' EXIT
        return 0
    fi
    local lock_pid=''
    if [ -f "$START_LOCK/pid" ]; then
        lock_pid="$(head -n 1 "$START_LOCK/pid" | tr -d '[:space:]')"
    fi
    case "$lock_pid" in
        ''|*[!0-9]*|0|1) ;;
        *) if kill -0 "$lock_pid" 2>/dev/null; then fail '应用正在启动，请稍后重试'; fi ;;
    esac
    [ ! -f "$START_LOCK/pid" ] || rm -f "$START_LOCK/pid"
    rmdir "$START_LOCK" 2>/dev/null || fail '应用正在启动，请稍后重试'
    mkdir "$START_LOCK" 2>/dev/null || fail '应用正在启动，请稍后重试'
    printf '%s\n' "$$" > "$START_LOCK/pid"
    trap 'rm -f "$START_LOCK/pid"; rmdir "$START_LOCK" 2>/dev/null || true' EXIT
}
start_app() {
    if status_app; then return 0; fi
    [ -x "$BIN" ] || fail '应用服务文件缺失，请重新安装对应架构的安装包'
    mkdir -p "$TRIM_PKGVAR" "$TRIM_PKGETC" "$TRIM_PKGTMP"
    acquire_start_lock
    if status_app; then return 0; fi
    cd "$TRIM_APPDEST"
    GIN_MODE=release "$BIN" >> "$LOG_FILE" 2>&1 &
    local pid=$!
    printf '%s\n' "$pid" > "$PID_FILE"
    local count=0
    while [ "$count" -lt 20 ]; do
        check_process "$pid" || fail '服务启动失败，请查看应用日志'
        if [ -S "$SOCKET" ]; then return 0; fi
        sleep 1; count=$((count + 1))
    done
    stop_app
    fail '服务启动超时，请查看应用日志'
}
case "${1:-}" in
    start) start_app ;;
    stop) stop_app ;;
    status) if status_app; then exit 0; else exit 3; fi ;;
    *) fail '不支持的运行操作' ;;
esac
